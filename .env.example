# Copy this file to .env and fill in the values. Never commit .env.
# Hardhat (hardhat.config.js) and Next.js both read .env.

## Contract deployment (only needed for `npm run deploy`)

# RPC URL of the testnet node to deploy through. Get one free from a provider
# such as Alchemy or Infura (create an app for the network you deploy to).
HOLESKY_URL=https://your-rpc-provider.example/v2/your-api-key
# Optional fallback RPC URL, used when HOLESKY_URL is empty.
HOLESKY_URL_OPTIONAL=

# Private key of the wallet that pays gas for the deployment. Use a fresh
# wallet that only ever holds testnet ETH. Never share or commit it.
PRIVATE_KEY=0xyour-deployer-private-key

## Frontend (read by Next.js at build time; NEXT_PUBLIC_ values are public)

# Address printed by `npm run deploy`.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Network the app asks MetaMask to switch to. One of the keys in
# Context/constants.js: holesky, polygon_amoy, polygon, bsc, base_mainnet,
# base_sepolia, localhost.
NEXT_PUBLIC_NETWORK=holesky
